/// Vendas, perdas e anomalias de perda do e-commerce Olist (2016-2018, BRL). Anomalia = semana em que uma taxa de perda saiu do padrão; traz impacto, prioridade, responsável e hipótese gerada por IA.
model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

ref table Calendário
ref table Cliente
ref table Vendedor
ref table Produto
ref table 'Status do Pedido'
ref table 'Forma de Pagamento'
ref table Vendas
ref table Pedidos
ref table Pagamentos
ref table 'Anomalias de Perda'

ref cultureInfo en-US
